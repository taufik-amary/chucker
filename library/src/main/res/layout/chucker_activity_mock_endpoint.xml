<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="@style/Chucker.Theme"
            app:title="@string/chucker_mock_endpoint_title" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/chucker_doub_grid"
        android:paddingTop="@dimen/chucker_doub_grid">

        <TextView
            android:id="@+id/networkInterceptorNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/chucker_doub_grid"
            android:text="@string/chucker_mock_network_interceptor"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/endpoint"
            style="@style/Chucker.TextAppearance.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            tools:text="GET https://example.com/users" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/enabledSwitch"
            style="@style/Chucker.TextAppearance.ListItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/chucker_doub_grid"
            android:minHeight="48dp"
            android:text="@string/chucker_mock_enabled" />

    </LinearLayout>

    <!-- Shown while mocking is on. -->
    <LinearLayout
        android:id="@+id/mocksSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/chooseHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/chucker_base_grid"
            android:paddingHorizontal="@dimen/chucker_doub_grid"
            android:text="@string/chucker_mock_choose" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mocksRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/chucker_list_item_mock" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingHorizontal="@dimen/chucker_doub_grid"
            android:text="@string/chucker_mock_endpoint_empty"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/newMock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/chucker_doub_grid"
            android:text="@string/chucker_mock_new"
            android:textAlignment="center" />

    </LinearLayout>

</LinearLayout>
